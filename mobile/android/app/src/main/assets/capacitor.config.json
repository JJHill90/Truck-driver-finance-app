{
	"appId": "com.haulagefinance.app",
	"appName": "Driver Hub",
	"webDir": "www",
	"server": {
		"cleartext": false,
		"androidScheme": "https",
		"errorPath": "index.html",
		"allowNavigation": [
			"https://www.godriverhub.com/*",
			"https://godriverhub.com/*"
		]
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#0b1f33"
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#0b1f33",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0b1f33"
		},
		"Camera": {
			"saveToGallery": false
		}
	}
}
