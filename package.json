{
  "name": "haulage-finance-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tax services tracker for Australian truck drivers — expenses, income/remittances, receipt OCR, EOFY report and forecast.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:android": "npm --prefix mobile run open:android"
  },
  "dependencies": {
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "mupdf": "^1.28.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.68.4",
    "pdf-parse": "^2.1.7",
    "pdfkit": "^0.19.1",
    "stripe": "^17.7.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "vitest": "^2.1.3"
  }
}
