{
	"appId": "com.gotaxation.suite",
	"appName": "Go Taxation Suite",
	"webDir": "www",
	"server": {
		"cleartext": false,
		"androidScheme": "https",
		"errorPath": "index.html"
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#0b1f33"
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#0b1f33",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0b1f33"
		},
		"Camera": {
			"saveToGallery": false
		}
	}
}
